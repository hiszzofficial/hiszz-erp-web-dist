DirectoryIndex index.html

<IfModule mod_mime.c>
    AddType application/wasm .wasm
    AddType application/javascript .js .mjs
    <FilesMatch "\.mjs$">
        ForceType application/javascript
    </FilesMatch>
    AddType application/json .json
    AddType font/otf .otf
    AddType font/ttf .ttf
    AddType font/woff2 .woff2
    AddType image/png .png
    AddType image/x-icon .ico
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/wasm
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
    <FilesMatch "\.wasm$">
        Header set Content-Type "application/wasm"
    </FilesMatch>
    <FilesMatch "\.mjs$">
        Header set Content-Type "application/javascript"
    </FilesMatch>
    <FilesMatch "\.(js|mjs|wasm)$">
        Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
    </FilesMatch>
    <FilesMatch "index\.html$">
        Header set Cache-Control "public, max-age=120, stale-while-revalidate=86400"
    </FilesMatch>
    <FilesMatch "flutter_bootstrap\.js$">
        Header set Cache-Control "public, max-age=60, must-revalidate"
    </FilesMatch>
    <FilesMatch "flutter_service_worker\.js$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(png|jpg|jpeg|webp|gif|ico|woff2|woff|otf|ttf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

ErrorDocument 404 /index.html

RewriteEngine On
RewriteBase /
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule \.mjs$ - [T=application/javascript,L]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]
RewriteRule ^ index.html [L]
